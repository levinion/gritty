# Maintainer: levinion <https://github.com/levinion>
pkgname=gritty
pkgver=2026.11.26
pkgrel=1
pkgdesc="CPU-rendered terminal emulator for tmux on Linux and macOS"
arch=('x86_64' 'aarch64')
url='https://github.com/levinion/gritty'
license=('MIT')
depends=(
  'pixman'
  'freetype2'
  'harfbuzz'
  'libutf8proc'
  'libpng'
  'zlib'
  'wayland'
  'libxkbcommon'
  'fontconfig'
)
makedepends=(
  'meson'
  'ninja'
  'pkgconf'
  'wayland-protocols'
)
checkdepends=('doctest' 'tmux' 'ttf-dejavu')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  arch-meson "${pkgname}-${pkgver}" build -Dtests=true
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
  install -Dm644 "${pkgname}-${pkgver}/packaging/linux/gritty.desktop" \
    "${pkgdir}/usr/share/applications/gritty.desktop"
  if [[ -f "${pkgname}-${pkgver}/LICENSE" ]]; then
    install -Dm644 "${pkgname}-${pkgver}/LICENSE" \
      "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi
}
